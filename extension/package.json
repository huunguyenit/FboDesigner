{
  "name": "fbo-designer",
  "displayName": "FBO Designer",
  "description": "Xem và (về sau) kéo thả thiết kế form FBO ngay trong VS Code.",
  "version": "0.0.2",
  "publisher": "NGUYENTDH",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onWebviewPanel:fboDesigner.preview"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "fboDesigner.form",
        "displayName": "%fboDesigner.form.displayName%",
        "selector": [
          {
            "filenamePattern": "**/Dir/*.xml"
          },
          {
            "filenamePattern": "**/Filter/*.xml"
          },
          {
            "filenamePattern": "**/Grid/*.xml"
          },
          {
            "filenamePattern": "**/Dir/*.f"
          },
          {
            "filenamePattern": "**/Filter/*.f"
          },
          {
            "filenamePattern": "**/Grid/*.f"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "fboDesigner.open",
        "category": "FBO Designer",
        "title": "%fboDesigner.open.title%"
      },
      {
        "command": "fboDesigner.declareFilter",
        "category": "FBO Designer",
        "title": "%fboDesigner.declareFilter.title%"
      },
      {
        "command": "fboDesigner.addColumns",
        "category": "FBO Designer",
        "title": "%fboDesigner.addColumns.title%"
      },
      {
        "command": "fboDesigner.showDialogDemo",
        "category": "FBO Designer",
        "title": "%fboDesigner.showDialogDemo.title%"
      },
      {
        "command": "fboDesigner.deleteSelection",
        "category": "FBO Designer",
        "title": "%fboDesigner.deleteSelection.title%"
      }
    ],
    "keybindings": [
      {
        "command": "fboDesigner.open",
        "key": "ctrl+alt+o",
        "when": "editorTextFocus"
      },
      {
        "command": "fboDesigner.declareFilter",
        "key": "ctrl+alt+f",
        "when": "resourceScheme == file && resourceExtname =~ /\\.(xml|f)$/ && editorTextFocus"
      },
      {
        "command": "fboDesigner.deleteSelection",
        "key": "delete",
        "when": "activeCustomEditorId == 'fboDesigner.form'"
      },
      {
        "command": "fboDesigner.deleteSelection",
        "key": "shift+delete",
        "when": "activeCustomEditorId == 'fboDesigner.form'",
        "args": { "shift": true }
      },
      {
        "command": "fboDesigner.deleteSelection",
        "key": "delete",
        "when": "activeWebviewPanelId == 'fboDesigner.preview'"
      },
      {
        "command": "fboDesigner.deleteSelection",
        "key": "shift+delete",
        "when": "activeWebviewPanelId == 'fboDesigner.preview'",
        "args": { "shift": true }
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "fboDesigner.showDialogDemo",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "submenu": "fboDesigner.mainMenu",
          "when": "resourceScheme == file && resourceExtname =~ /\\.(xml|f)$/",
          "group": "navigation@20"
        }
      ],
      "fboDesigner.mainMenu": [
        {
          "command": "fboDesigner.declareFilter",
          "when": "resourceScheme == file && resourceExtname =~ /\\.(xml|f)$/",
          "group": "navigation@10"
        },
        {
          "command": "fboDesigner.addColumns",
          "when": "resourceScheme == file && resourceExtname =~ /\\.(xml|f)$/",
          "group": "navigation@15"
        },
        {
          "command": "fboDesigner.open",
          "when": "resourceScheme == file && resourceExtname =~ /\\.(xml|f)$/",
          "group": "navigation@20"
        }
      ]
    },
    "submenus": [
      {
        "id": "fboDesigner.mainMenu",
        "label": "%fboDesigner.mainMenu.title%"
      }
    ],
    "configuration": {
      "title": "%fboDesigner.config.title%",
      "properties": {
        "fboDesigner.panelPosition": {
          "type": "string",
          "enum": [
            "right",
            "beside",
            "active"
          ],
          "enumDescriptions": [
            "%fboDesigner.panelPosition.right%",
            "%fboDesigner.panelPosition.beside%",
            "%fboDesigner.panelPosition.active%"
          ],
          "default": "right",
          "category": "FBO Designer",
          "description": "%fboDesigner.panelPosition.desc%"
        },
        "fboDesigner.confirmForeignEdit": {
          "type": "boolean",
          "default": true,
          "category": "FBO Designer",
          "description": "%fboDesigner.confirmForeignEdit.desc%"
        },
        "fboDesigner.confirmDelete": {
          "type": "boolean",
          "default": true,
          "category": "FBO Designer",
          "description": "%fboDesigner.confirmDelete.desc%"
        },
        "fboDesigner.revealRelatedFiles": {
          "type": "string",
          "enum": [
            "one",
            "all"
          ],
          "enumDescriptions": [
            "%fboDesigner.revealRelatedFiles.one%",
            "%fboDesigner.revealRelatedFiles.all%"
          ],
          "default": "all",
          "category": "FBO Designer",
          "description": "%fboDesigner.revealRelatedFiles.desc%"
        },
        "fboDesigner.entityEditTarget": {
          "type": "string",
          "enum": [
            "ask",
            "source",
            "inline"
          ],
          "enumDescriptions": [
            "%fboDesigner.entityEditTarget.ask%",
            "%fboDesigner.entityEditTarget.source%",
            "%fboDesigner.entityEditTarget.inline%"
          ],
          "default": "ask",
          "category": "FBO Designer",
          "description": "%fboDesigner.entityEditTarget.desc%"
        }
      }
    }
  },
  "scripts": {
    "test:core": "node ../core/test/run.mjs"
  },
  "dependencies": {},
  "devDependencies": {}
}
