{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FBO Designer: Extension Host",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/extension"
      ],
      "debugWebviews": true
    },
    {
      "name": "FBO Designer: Extension Host + DevTools",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/extension",
        "--open-devtools"
      ],
      "debugWebviews": true
    }
  ]
}
